                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "Allocator that uses stack allocation for up to"
                                        },
                                        {
                                            "@type": "DocCommentCodeInline@1",
                                            "text": "stackSize"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "bytes and"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "then falls back to"
                                        },
                                        {
                                            "@type": "DocCommentCodeInline@1",
                                            "text": "Allocator"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": ". Defined as:"
                                        }
                                    ]
                                },
                                {
                                    "@type": "DocCommentParagraphBlock@1",
                                    "inlines": [
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "----"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "alias StackFront(size_t stackSize, Allocator) ="
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "FallbackAllocator!("
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "InSituRegion!(stackSize, Allocator.alignment,"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "hasMember!(Allocator, \"deallocate\")"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "? Yes.defineDeallocate"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": ": No.defineDeallocate),"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "Allocator);"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "----"
                                        }
                                    ]
                                },
                                {
                                    "@type": "DocCommentParagraphBlock@1",
                                    "inlines": [
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "Choosing"
                                        },
                                        {
                                            "@type": "DocCommentCodeInline@1",
                                            "text": "stackSize"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "is as always a compromise. Too small a size exhausts the"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "stack storage after a few allocations, after which there are no gains over the"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "backup allocator. Too large a size increases the stack consumed by the thread"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "and may end up worse off because it explores cold portions of the stack."
                                        }
                                    ]
                                }
