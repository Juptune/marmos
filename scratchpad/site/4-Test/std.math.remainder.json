                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "Calculates the remainder from the calculation x\/y."
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "Returns:"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "The value of x - i"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "y, where i is the number of times that y can"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "be completely subtracted from x. The result has the same sign as x."
                                        }
                                    ]
                                },
                                {
