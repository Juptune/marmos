                                {
                                    "@type": "DocCommentParagraphBlock@1",
                                    "inlines": [
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "Calculate the remainder x REM y, following IEC 60559."
                                        }
                                    ]
                                },
                                {
                                    "@type": "DocCommentParagraphBlock@1",
                                    "inlines": [
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "REM is the value of x - y"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "n, where n is the integer nearest the exact"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "value of x \/ y."
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "If |n - x \/ y| == 0.5, n is even."
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "If the result is zero, it has the same sign as x."
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "Otherwise, the sign of the result is the sign of x \/ y."
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "Precision mode has no effect on the remainder functions."
                                        }
                                    ]
                                },
                                {
                                    "@type": "DocCommentParagraphBlock@1",
                                    "inlines": [
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "remquo returns"
                                        },
                                        {
                                            "@type": "DocCommentCodeInline@1",
                                            "text": "n"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "in the parameter"
                                        },
                                        {
                                            "@type": "DocCommentCodeInline@1",
                                            "text": "n"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "."
                                        }
                                    ]
                                },
                                {
                                    "@type": "DocCommentParagraphBlock@1",
                                    "inlines": [
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "$(TABLE_SV"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "$(TR $(TH x)               $(TH y)            $(TH remainder(x, y)) $(TH n)   $(TH invalid?))"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "$(TR $(TD $(PLUSMN)0.0)    $(TD not 0.0)      $(TD $(PLUSMN)0.0)    $(TD 0.0) $(TD no))"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "$(TR $(TD $(PLUSMNINF))    $(TD anything)     $(TD -$(NAN))         $(TD ?)   $(TD yes))"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "$(TR $(TD anything)        $(TD $(PLUSMN)0.0) $(TD $(PLUSMN)$(NAN)) $(TD ?)   $(TD yes))"
                                        },
