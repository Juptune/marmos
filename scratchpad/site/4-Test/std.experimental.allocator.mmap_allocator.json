                                {
                                    "@type": "DocCommentParagraphBlock@1",
                                    "inlines": [
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "Allocator (currently defined only for Posix and Windows) using"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "$(D $(LINK2 https:\/\/en.wikipedia.org\/wiki\/Mmap, mmap))"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "and $(D $(LUCKY munmap)) directly (or their Windows equivalents). There is no"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "additional structure: each call to"
                                        },
                                        {
                                            "@type": "DocCommentCodeInline@1",
                                            "text": "allocate(s)"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "issues a call to"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "$(D mmap(null, s, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)),"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "and each call to"
                                        },
                                        {
                                            "@type": "DocCommentCodeInline@1",
                                            "text": "deallocate(b)"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "issues $(D munmap(b.ptr, b.length))."
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "So"
                                        },
                                        {
                                            "@type": "DocCommentCodeInline@1",
                                            "text": "MmapAllocator"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "is usually intended for allocating large chunks to be"
                                        },
                                        {
                                            "@type": "DocCommentTextInline@1",
                                            "text": "managed by fine-granular allocators."
                                        }
                                    ]
                                }
                            ],
                            "title": "__default"
                        }
                    ]
